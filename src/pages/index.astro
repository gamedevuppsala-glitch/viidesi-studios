---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Heroes from '../components/Heroes.astro';
import Icon from '../components/Icon.astro';
import { GAME, SITE, u } from '../site.config';
import { LANDMARKS, MOVES, WATCHERS, FACTS, FAQ } from '../data/game';
import { game, faqPage } from '../lib/schema';

import panCity from '../assets/shots/pan-city.jpg';
import panDiwali from '../assets/shots/pan-diwali.jpg';
import friends from '../assets/shots/screenshot-06-friends.jpg';
import ghar from '../assets/shots/screenshot-07-ghar.jpg';
import outfits from '../assets/shots/costumes_new30_fullbody.jpg';
import stepwell from '../assets/shots/stepwell_a.jpg';
import chowk from '../assets/shots/chowk_b.jpg';
import cars from '../assets/shots/flyingcars_lineup.jpg';

const shots = ['og/chhatpat.jpg', 'og/home.jpg', 'media/clips/kite_chase.jpg', 'media/clips/diwali_wide.jpg'];
const schema = [game(shots, { url: 'media/chhatpat-trailer.mp4', poster: 'media/chhatpat-trailer-poster-clean.jpg' }), faqPage(FAQ.slice(0, 8))];
const media = (p: string) => u('media/' + p);
const chapters = [
  { clip: 'fly_redfort', eyebrow: 'Har run naya', title: 'A new Indian city every run', text: 'Havelis, chawls, bazaars, gullies, temples, masjids, gurudwaras and stepwells, built fresh each time you press play. Shops and workshops are packed inside, and front doors open.', desi: 'Har baar naya shehar' },
  { clip: 'kite_behind', eyebrow: 'Skyline', title: 'Eight landmarks over the rooftops', text: "The Red Fort, Qutub Minar, India Gate, Humayun's Tomb, Jama Masjid, Akshardham, the Lotus Temple and Agrasen ki Baoli rise above the chhats. Use them to find your way.", desi: 'Qutub Minar dikh raha hai?' },
  { clip: 'hook_street', eyebrow: 'Zinda shehar', title: 'A street life of 100+ kinds of people', text: 'Chaiwalas, golgappe wale, dabbawalas, shoppers popping into open shops. Autos below, sky buses and drones above. Everyone has their own walk.', desi: 'Poora mohalla zinda hai' },
  { clip: 'diwali_roof', eyebrow: 'Mausam', title: 'Five skies and a Diwali Mela', text: 'Monsoon, fog and dust storms, golden mornings and moonlit nights. Festival seasons like the Diwali Mela light up every roof in the city.', desi: 'Shubh Deepawali, har chhat pe' },
];
---
<Base
  title="Chhatpat! Desi Rooftop Run, a free Indian parkour game for Android | Viidesi Studios"
  description="Chhatpat! is a free rooftop parkour game made in India. Run across a new desi city every run, fly kites, dodge Uncle Ji and race 4 friends on the same Wi-Fi, offline. By Viidesi Studios."
  keywords="Chhatpat, Chhatpat game, Indian game, desi game, Made in India game, rooftop runner, parkour game Android, Indian mobile game, offline game, Wi-Fi multiplayer game, Hinglish game, kite game, Diwali game, Viidesi Studios"
  schema={schema}
>
  <!-- ============ HERO: the 3D rooftop run ============ -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-gl" id="hero-gl">
      <img class="hero-still" src={u('media/chhatpat-trailer-poster-clean.jpg')} alt="" fetchpriority="high" width="1280" height="674" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner" data-enter>
      <p class="eyebrow"><span data-desi-text="Viidesi Studios ka pehla game">Viidesi Studios presents</span></p>
      <h1 id="hero-title">
        <span class="hero-word">Chhatpat!</span>
        <span class="hero-sub" data-desi-text="Chhat se chhat tak, desi rooftop run">The desi rooftop runner for Android</span>
      </h1>
      <p class="lede" data-desi-text="Har run mein naya shehar. Patang udao, chai piyo, Uncle Ji se bacho, aur 4 doston ke saath ek hi Wi-Fi pe race lagao. Bilkul free.">A new Indian city every run. Fly a patang, gulp chai, dodge Uncle Ji, and race up to 4 friends on one Wi-Fi with no internet. Free on Google Play.</p>
      <div class="hero-cta">
        <a class="btn" href={GAME.play} rel="noopener" data-magnet><Icon name="play-store" /> <span data-desi-text="Abhi khelo, free">Get it on Google Play</span></a>
        <a class="btn ghost" href={media('chhatpat-trailer.mp4')} data-trailer><span class="play-ico"><Icon name="play" /></span> <span data-desi-text="Trailer dekho">Watch the trailer</span></a>
      </div>
    </div>
    <p class="hero-hud" id="hero-hud" aria-live="polite" data-desi-text="Shehar pe tap karo, gully kood jao">Tap the city to jump the gully</p>
  </section>

  <!-- ============ FACT STRIP ============ -->
  <section class="facts" aria-label="Chhatpat in numbers">
    <div class="wrap facts-grid">
      {FACTS.map((f) => (
        <div class="fact">
          <strong data-count={parseInt(f.v)} data-suffix={f.v.replace(/[0-9]/g, '')}>{f.v}</strong>
          <span>{f.k}</span>
          <small>{f.note}</small>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ TRAILER ============ -->
  <section id="trailer-sec" class="trailer-sec" aria-labelledby="trailer-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Trailer</p>
        <h2 id="trailer-h" data-reveal data-desi-text="36 second, poora mohalla">The 36-second trailer</h2>
        <p class="lede">Rooftop jumps, kites, Uncle Ji, a Diwali night and friends on one Wi-Fi. Captured in the game, nothing staged.</p>
      </div>
      <a class="frame zoom trailer-frame" href={media('chhatpat-trailer.mp4')} data-trailer aria-label="Play the Chhatpat trailer with sound">
        <video data-auto muted loop playsinline preload="none" data-src={media('chhatpat-loop.mp4')} poster={media('chhatpat-trailer-poster-clean.jpg')} aria-hidden="true"></video>
        <span class="trailer-play"><Icon name="play" /><span>Play with sound</span></span>
      </a>
    </div>
  </section>

  <!-- ============ CITY: pinned chapters ============ -->
  <section id="city" class="city ground-indigo" aria-labelledby="city-h" data-chapters>
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">The city</p>
        <h2 id="city-h" data-reveal data-desi-text="Ek desi shehar, har baar naya">One desi city, built new every run</h2>
      </div>
      <div class="chap">
        <div class="chap-media" aria-hidden="true">
          {chapters.map((c, i) => (
            <div class={`phone ${i === 0 ? 'on' : ''}`}>
              <div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${c.clip}.mp4`)} poster={media(`clips/${c.clip}.jpg`)}></video></div>
            </div>
          ))}
        </div>
        <ol class="chap-steps">
          {chapters.map((c, i) => (
            <li class={`chap-step ${i === 0 ? 'on' : ''}`}>
              <div class="phone chap-inline" aria-hidden="true"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${c.clip}.mp4`)} poster={media(`clips/${c.clip}.jpg`)}></video></div></div>
              <span class="chap-n">0{i + 1}</span>
              <p class="eyebrow">{c.eyebrow}</p>
              <h3 data-desi-text={c.desi}>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="marquee landmarks" aria-label="Landmarks in Chhatpat">
      {[0, 1].map((k) => (
        <ul class="marquee__track" aria-hidden={k === 1 ? 'true' : undefined}>
          {LANDMARKS.map((l) => <li>{l}<span class="kite-dot" aria-hidden="true"></span></li>)}
        </ul>
      ))}
    </div>
  </section>

  <!-- ============ PANORAMA ============ -->
  <section class="pano" aria-labelledby="pano-h">
    <div class="pano-img frame">
      <Picture src={panCity} formats={['avif', 'webp']} widths={[768, 1280, 1920]} sizes="100vw" alt="Chhatpat's procedurally built Indian city from above: colourful houses, water tanks on every roof, a gurudwara with golden domes, haze to the horizon" />
    </div>
    <div class="wrap pano-copy">
      <h2 id="pano-h" data-reveal>Every roof is a route</h2>
      <p class="lede">No lanes, no rails. Sprint from chhat to chhat, leap the gullies, climb the green pipes, catch ledges, slide under washing lines and air-dash over the gaps. Pick a lock and walk in through a front door and out the back.</p>
    </div>
  </section>

  <!-- ============ MOVES ============ -->
  <section id="moves" class="moves" aria-labelledby="moves-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Power-ups</p>
        <h2 id="moves-h" data-reveal data-desi-text="Patang, chai aur gulel">Patang, chai and gulel: three power-ups</h2>
        <p class="lede">Plus 12 kinds of boosts lying in the street. Each hero also has a special move: Dhol Blast, Paan Pichkaari, "Khana Khaya?" and more.</p>
      </div>
      <div class="moves-grid">
        {MOVES.map((m) => (
          <article class="move">
            <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${m.clip}.mp4`)} poster={media(`clips/${m.clip}.jpg`)} aria-hidden="true"></video></div></div>
            <h3><span class="move-name">{m.name}</span></h3>
            <p data-desi-text={m.desi + '. ' + m.text}>{m.text}</p>
          </article>
        ))}
      </div>
      <div class="watchers">
        <h3 data-desi-text="Mohalla dekh raha hai">The mohalla is watching</h3>
        <div class="watch-row">
          <div class="phone mini"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media('clips/v_monkeys.mp4')} poster={media('clips/v_monkeys.jpg')} aria-hidden="true"></video></div></div>
          <div class="phone mini"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media('clips/v_seth.mp4')} poster={media('clips/v_seth.jpg')} aria-hidden="true"></video></div></div>
          <ul class="watch-list">
            {WATCHERS.map((w) => <li>{w}</li>)}
          </ul>
        </div>
        <p class="watch-quote">Uncle Ji will remind you that Sharma ji's son got 98%.</p>
      </div>
    </div>
  </section>

  <!-- ============ HEROES ============ -->
  <Heroes />

  <!-- ============ FRIENDS + GHAR ============ -->
  <section id="friends" class="friends" aria-labelledby="friends-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Doston ke saath</p>
        <h2 id="friends-h" data-reveal data-desi-text="Doston ke saath, bina internet">Play with 4 friends on one Wi-Fi</h2>
      </div>
      <div class="split">
        <div class="frame zoom split-img"><Picture src={friends} formats={['avif', 'webp']} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 56vw" alt="The Doston ke Saath screen in Chhatpat: host a game or join with a 5-digit game ID" /></div>
        <div class="split-copy">
          <ol class="steps">
            <li><strong>Host a game.</strong> You get a 5-digit game ID.</li>
            <li><strong>Friends type it in.</strong> Same Wi-Fi or a phone hotspot. No internet.</li>
            <li><strong>Race the same errand.</strong> Everyone's house stands in one shared city.</li>
            <li><strong>Winner takes all.</strong> Stake up to 3 things from your home.</li>
          </ol>
        </div>
      </div>
      <div class="split rev">
        <div class="frame zoom split-img"><Picture src={ghar} formats={['avif', 'webp']} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 56vw" alt="Ghar Sajao in Chhatpat: a furnished house seen from above with a catalogue of home objects" /></div>
        <div class="split-copy">
          <h3 data-desi-text="Apna ghar sajao">Your own ghar in every city</h3>
          <p>Every run starts on your terrace. A kothi with a garden, furnished rooms and the whole joint family. Bring home what you find in the city: sofas, a jhoola, charpais, a mandir, a cooler, matkas and 284 things in all.</p>
          <p class="split-note">Today's City gives everyone the same city each day. Set your best time before a new one arrives at midnight.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OUTFITS ============ -->
  <section class="outfits ground-indigo" aria-labelledby="outfits-h">
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow">Dukaan</p>
        <h2 id="outfits-h" data-reveal>55 outfits, each with a power</h2>
        <p class="lede">From the Neon Kurta to the Superhero Lungi and Gold Chain Bhai. Outfits replace upgrades: what you wear is how you run.</p>
      </div>
    </div>
    <div class="outfit-strip">
      <Image src={outfits} widths={[1200, 2560]} sizes="100vw" alt="Thirty Chhatpat outfits in a row: kurtas, lungis, sherwanis, a saree, a raincoat and more on blocky heroes" />
    </div>
    <div class="wrap outfit-more">
      <div class="frame zoom"><Picture src={stepwell} formats={['avif', 'webp']} widths={[640, 1000]} sizes="(max-width: 900px) 100vw, 33vw" alt="A stepwell in Chhatpat's city with carved walls and shrines" /></div>
      <div class="frame zoom"><Picture src={chowk} formats={['avif', 'webp']} widths={[640, 1000]} sizes="(max-width: 900px) 100vw, 33vw" alt="A busy chowk in Chhatpat with stalls and shoppers" /></div>
      <div class="frame zoom"><Picture src={cars} formats={['avif', 'webp']} widths={[640, 1000]} sizes="(max-width: 900px) 100vw, 33vw" alt="Four kinds of flying cars in Chhatpat, from a tempo to a rickshaw" /></div>
    </div>
  </section>

  <!-- ============ STUDIO + BRANDS ============ -->
  <section id="studio" class="studio-teaser" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Viidesi Studios</p>
        <h2 id="studio-h" data-reveal>Chhatpat is game one</h2>
        <p class="lede">Viidesi Studios is an independent Indian game studio. We make games about the India outside the window, right now, not a postcard. More games are in the works.</p>
      </div>
      <div class="cards3">
        <a class="card" href={u('studio/#brands')}>
          <span class="card-k">For brands</span>
          <h3>Billboards inside the city</h3>
          <p>Thousands of in-world hoardings, LED screens and weekly brand hunts. No pop-ups, ever.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
        <a class="card" href={u('chhatpat/#press')}>
          <span class="card-k">For press and creators</span>
          <h3>The Chhatpat press kit</h3>
          <p>Fact sheet, screenshots, the icon and the trailer, ready to download.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
        <a class="card" href={u('devlog/')}>
          <span class="card-k">For the curious</span>
          <h3>The devlog</h3>
          <p>How a whole Indian city gets built in seconds on a phone, and other notes.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <Faq items={FAQ.slice(0, 8)} />

  <!-- ============ CLOSE ============ -->
  <section class="close" aria-labelledby="close-h">
    <Picture class="close-bg" src={panDiwali} formats={['avif', 'webp']} widths={[768, 1280, 1920]} sizes="100vw" alt="" />
    <div class="wrap close-inner">
      <h2 id="close-h" data-reveal><span class="deva" lang="hi">चलो,</span> chhat pe milte hain</h2>
      <p class="lede">Free on Google Play. Plays offline. Five graphics modes, from 4 GB phones to flagships.</p>
      <a class="btn" href={GAME.play} rel="noopener" data-magnet><Icon name="play-store" /> <span data-desi-text="Abhi khelo, free">Get it on Google Play</span></a>
    </div>
  </section>

  <dialog id="trailer" class="dlg" aria-label="Chhatpat trailer">
    <button class="dlg-close" type="button" aria-label="Close the trailer">×</button>
    <video controls playsinline preload="none" data-src={media('chhatpat-trailer.mp4')} poster={media('chhatpat-trailer-poster-clean.jpg')}></video>
  </dialog>
</Base>

<style>
  /* hero */
  .hero { position: relative; min-height: 100svh; padding: 0 !important; display: grid; align-items: end; overflow: hidden; background: #2a2160; }
  .hero-gl { position: absolute; inset: 0; cursor: pointer; }
  .hero-gl :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 1s; }
  .hero-gl[data-gl='on'] .hero-still { opacity: 0; }
  .hero-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(7,13,38,.55) 0%, transparent 22%, transparent 45%, rgba(7,13,38,.85) 100%), linear-gradient(90deg, rgba(7,13,38,.6), transparent 60%); }
  .hero-inner { position: relative; z-index: 2; padding-bottom: clamp(72px, 12vh, 130px); padding-top: 140px; display: grid; gap: 22px; pointer-events: none; }
  .hero-inner > * { pointer-events: auto; max-width: 760px; }
  .hero h1 { display: grid; gap: 10px; }
  .hero-word { font-size: clamp(4.2rem, 13vw, 11.5rem); line-height: 0.82; color: var(--saffron); font-variation-settings: 'wdth' 75, 'opsz' 96; letter-spacing: -0.045em; text-shadow: 0 6px 0 #c4520a, 0 20px 60px rgba(0,0,0,.45); }
  .hero-sub { font-size: clamp(1.5rem, 3vw, 2.6rem); letter-spacing: -0.02em; color: var(--cream); line-height: 1; }
  .hero .lede { color: rgba(255,244,226,.86); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-hud { position: absolute; z-index: 3; right: var(--gutter); bottom: clamp(72px, 12vh, 130px); margin: 0; padding: 10px 16px 10px 40px; border-radius: 999px; background: rgba(7,13,38,.55); backdrop-filter: blur(10px); font-weight: 700; font-size: 0.9rem; box-shadow: inset 0 0 0 1px var(--line); pointer-events: none; }
  .hero-hud::before { content: ''; position: absolute; left: 16px; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: var(--saffron); box-shadow: 0 0 0 0 rgba(255,194,61,.7); animation: ping 1.8s infinite; }
  .hero-hud[data-state='fall']::before { background: var(--rani); }
  @keyframes ping { 70% { box-shadow: 0 0 0 12px rgba(255,194,61,0); } 100% { box-shadow: 0 0 0 0 rgba(255,194,61,0); } }
  @media (max-width: 760px) {
    .hero-hud { left: var(--gutter); right: auto; top: calc(var(--nav-h) + 8px); bottom: auto; }
    .hero-cta .btn { width: 100%; }
  }

  @media (max-height: 600px) and (orientation: landscape) {
    .hero-inner { padding-top: 96px; padding-bottom: 32px; gap: 12px; }
    .hero-word { font-size: clamp(3rem, 11vh, 5rem); }
    .hero-sub { font-size: 1.3rem; }
    .hero .lede { font-size: 1rem; max-width: 52ch; }
    .hero-cta .btn { width: auto; }
    .hero-hud { top: auto; bottom: 24px; left: auto; right: var(--gutter); }
  }

  /* facts */
  .facts { padding-block: 44px !important; border-bottom: 1px solid var(--line); background: var(--night); }
  .facts-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 24px; }
  .fact { display: grid; gap: 2px; }
  .fact strong { font: 800 clamp(2.2rem, 3.4vw, 3.2rem)/1 var(--display); color: var(--saffron); letter-spacing: -0.03em; font-variation-settings: 'wdth' 80; }
  .fact span { font-weight: 700; }
  .fact small { color: var(--muted); font-size: 0.85rem; line-height: 1.35; }
  @media (max-width: 1000px) { .facts-grid { grid-template-columns: repeat(3, 1fr); row-gap: 32px; } }
  @media (max-width: 560px) { .facts-grid { grid-template-columns: repeat(2, 1fr); } }

  /* trailer */
  .trailer-frame { display: block; aspect-ratio: 16 / 9; box-shadow: 0 60px 120px -40px rgba(0,0,0,.8); }
  .trailer-play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: inline-flex; align-items: center; gap: 12px; padding: 14px 24px 14px 16px; border-radius: 999px; background: var(--saffron); color: var(--ink); font-weight: 800; white-space: nowrap; transition: transform .4s var(--ease); }
  .trailer-play :global(svg) { width: 34px; height: 34px; padding: 10px; border-radius: 50%; background: var(--ink); color: var(--saffron); }
  .trailer-frame:hover .trailer-play { transform: scale(1.06); }

  /* chapters */
  .chap { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: clamp(40px, 7vw, 120px); align-items: start; }
  .chap-media { position: sticky; top: calc(50vh - 300px); height: min(640px, 76vh); aspect-ratio: 9/16; }
  .chap-media .phone { position: absolute; inset: 0; opacity: 0; transform: scale(.94) rotate(-2deg); transition: opacity .6s var(--ease), transform .8s var(--ease); }
  .chap-media .phone:global(.on) { opacity: 1; transform: none; }
  .chap-steps { list-style: none; margin: 0; padding: 0; }
  .chap-step { min-height: 72vh; display: grid; align-content: center; gap: 14px; max-width: 520px; opacity: .35; transition: opacity .5s; }
  .chap-step:global(.on) { opacity: 1; }
  .chap-step h3 { font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: .98; }
  .chap-step p:not(.eyebrow) { color: var(--muted); font-size: 1.1rem; }
  .chap-n { font: 800 1rem/1 var(--display); color: var(--rani); }
  .chap-inline { display: none; }
  @media (max-width: 900px) {
    .chap { grid-template-columns: 1fr; }
    .chap-media { display: none; }
    .chap-step { min-height: 0; opacity: 1; margin-bottom: 64px; }
    .chap-inline { display: block; width: min(300px, 80%); margin-bottom: 12px; }
  }
  .landmarks { margin-top: clamp(40px, 6vw, 80px); }
  .landmarks ul { list-style: none; margin: 0; }
  .landmarks li { display: inline-flex; align-items: center; gap: 48px; font: 800 clamp(2.4rem, 6vw, 5rem)/1.1 var(--display); letter-spacing: -0.03em; white-space: nowrap; font-variation-settings: 'wdth' 80; }
  .landmarks li:nth-child(odd) { color: transparent; -webkit-text-stroke: 1.5px rgba(255,244,226,.55); }
  .kite-dot { width: 22px; height: 22px; background: var(--marigold); transform: rotate(45deg); border-radius: 3px; }

  /* panorama */
  .pano { padding: 0 !important; }
  .pano-img { border-radius: 0; height: min(78vh, 760px); }
  .pano-img :global(img) { height: 100%; }
  .pano-copy { position: relative; margin-top: -180px; z-index: 2; padding-bottom: clamp(80px, 10vw, 140px); display: grid; gap: 22px; }
  .pano-copy h2 { text-shadow: 0 10px 40px rgba(0,0,0,.5); }
  .pano::before { content: ''; position: absolute; inset: auto 0 0; height: 60%; background: linear-gradient(transparent, var(--night) 55%); z-index: 1; pointer-events: none; }

  /* moves */
  .moves-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }
  .move { display: grid; gap: 14px; }
