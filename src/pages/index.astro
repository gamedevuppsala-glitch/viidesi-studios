---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Card from '../components/HeroCard.astro';
import { GAME, u } from '../site.config';
import { LANDMARKS, MOVES, WATCHERS, FACTS, FAQ, HEROES } from '../data/game';
import { game, faqPage } from '../lib/schema';

import panCity from '../assets/shots/pan-city.jpg';
import panDiwali from '../assets/shots/diwali-full.jpg';
import friends from '../assets/shots/screenshot-06-friends.jpg';
import ghar from '../assets/shots/screenshot-07-ghar.jpg';
import outfits from '../assets/shots/costumes_new30_fullbody.jpg';
import huddle from '../assets/shots/huddle.jpg';
import cars from '../assets/shots/flyingcars_lineup.jpg';
import stepwell from '../assets/shots/stepwell_a.jpg';

const shots = ['og/chhatpat.jpg', 'og/home.jpg', 'media/clips/kite_chase.jpg', 'media/clips/diwali_wide.jpg'];
const faqs = FAQ.slice(0, 7);
const schema = [game(shots, { url: 'media/chhatpat-trailer.mp4', poster: 'media/chhatpat-trailer-poster-clean.jpg' }), faqPage(faqs)];
const media = (p: string) => u('media/' + p);
const chapters = [
  { clip: 'fly_redfort', eyebrow: 'Har run naya', title: 'A new Indian city every run', text: 'Havelis, chawls, bazaars, gullies, temples, masjids, gurudwaras and stepwells, built fresh each time you press play.', desi: 'Har baar naya shehar' },
  { clip: 'kite_behind', eyebrow: 'Skyline', title: '8 landmarks over the roofs', text: "The Red Fort, Qutub Minar, India Gate and Humayun's Tomb rise above the chhats. Use them to find your way.", desi: 'Qutub Minar dikh raha hai?' },
  { clip: 'hook_street', eyebrow: 'Zinda shehar', title: '100+ kinds of people', text: 'Chaiwalas, golgappe wale, dabbawalas, shoppers popping into open shops. Autos below, sky buses above.', desi: 'Poora mohalla zinda hai' },
  { clip: 'diwali_roof', eyebrow: 'Mausam', title: '5 skies and a Diwali Mela', text: 'Monsoon, fog, dust storms and moonlit nights. Festival seasons light up every roof in the city.', desi: 'Shubh Deepawali, har chhat pe' },
];
---
<Base
  title="Chhatpat! Desi Rooftop Run, a free Indian parkour game for Android | Viidesi Studios"
  description="Chhatpat! is a free rooftop parkour game made in India. Run across a new desi city every run, fly kites, dodge Uncle Ji and race 4 friends on the same Wi-Fi, offline. By Viidesi Studios."
  keywords="Chhatpat, Chhatpat game, Indian game, desi game, Made in India game, rooftop runner, parkour game Android, Indian mobile game, offline game, Wi-Fi multiplayer game, Hinglish game, kite game, Diwali game, Viidesi Studios"
  schema={schema}
  screens
>
  <!-- 1. HERO: the 3D rooftop run (1 screen) -->
  <section class="hero" id="top" aria-labelledby="hero-title" data-enter>
    <div class="hero-gl" id="hero-gl">
      <img class="hero-still" src={u('media/chhatpat-trailer-poster-clean.jpg')} alt="" fetchpriority="high" width="1280" height="674" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner" data-enter>
      <p class="eyebrow"><span data-desi-text="Viidesi Studios ka pehla game">Viidesi Studios presents</span></p>
      <h1 id="hero-title">
        <span class="hero-word">Chhatpat!</span>
        <span class="hero-sub" data-desi-text="Chhat se chhat tak, desi rooftop run">The desi rooftop runner for Android</span>
      </h1>
      <p class="lede" data-desi-text="Har run mein naya shehar. Patang udao, chai piyo, Uncle Ji se bacho, aur 4 doston ke saath ek hi Wi-Fi pe race lagao. Bilkul free.">A new Indian city every run. Fly a patang, gulp chai, dodge Uncle Ji, and race up to 4 friends on one Wi-Fi with no internet. Free on Google Play.</p>
      <div class="hero-cta">
        <a class="btn" href={GAME.play} rel="noopener" data-magnet><Icon name="play-store" /> <span data-desi-text="Abhi khelo, free">Get it on Google Play</span></a>
        <a class="btn ghost" href={media('chhatpat-trailer.mp4')} data-trailer><span class="play-ico"><Icon name="play" /></span> <span data-desi-text="Trailer dekho">Watch the trailer</span></a>
      </div>
    </div>
    <p class="hero-hud" id="hero-hud" aria-live="polite" data-desi-text="Shehar pe tap karo, gully kood jao">Tap the city to jump the gully</p>
  </section>

  <!-- 2. TRAILER + numbers (1 screen) -->
  <section id="trailer-sec" class="s trailer-sec" style="--h:1; --hm:1" aria-labelledby="trailer-h">
    <div class="wrap trailer-grid">
      <div class="trailer-copy">
        <h2 id="trailer-h" data-desi-text="36 second, poora mohalla">The 36-second trailer</h2>
        <p class="lede">Rooftop jumps, kites, Uncle Ji, a Diwali night and friends on one Wi-Fi. Captured in the game.</p>
        <dl class="facts-grid">
          {FACTS.map((f) => (
            <div class="fact">
              <dt>{f.k}</dt>
              <dd><strong data-count={parseInt(f.v)} data-suffix={f.v.replace(/[0-9]/g, '')}>{f.v}</strong><small>{f.note}</small></dd>
            </div>
          ))}
        </dl>
      </div>
      <a class="frame zoom trailer-frame" href={media('chhatpat-trailer.mp4')} data-trailer aria-label="Play the Chhatpat trailer with sound">
        <video data-auto muted loop playsinline preload="none" data-src={media('chhatpat-loop.mp4')} poster={media('chhatpat-trailer-poster-clean.jpg')} aria-hidden="true"></video>
        <span class="trailer-play"><Icon name="play" /><span>Play with sound</span></span>
      </a>
    </div>
  </section>

  <!-- 3. THE CITY (2 screens) -->
  <section id="city" class="s g2 city ground-indigo" style="--h:2; --hm:2" aria-labelledby="city-h">
    <div class="wrap">
      <div class="row">
        <h2 id="city-h" data-desi-text="Ek desi shehar, har baar naya">An Indian city, built new every run</h2>
        <div class="chap-row">
          {chapters.slice(0, 2).map((c) => (
            <article class="chap-card">
              <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${c.clip}.mp4`)} poster={media(`clips/${c.clip}.jpg`)} aria-hidden="true"></video></div></div>
              <div class="chap-text"><p class="eyebrow">{c.eyebrow}</p><h3 data-desi-text={c.desi}>{c.title}</h3><p>{c.text}</p></div>
            </article>
          ))}
        </div>
      </div>
      <div class="row">
        <div class="chap-row">
          {chapters.slice(2).map((c) => (
            <article class="chap-card">
              <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${c.clip}.mp4`)} poster={media(`clips/${c.clip}.jpg`)} aria-hidden="true"></video></div></div>
              <div class="chap-text"><p class="eyebrow">{c.eyebrow}</p><h3 data-desi-text={c.desi}>{c.title}</h3><p>{c.text}</p></div>
            </article>
          ))}
        </div>
        <div class="marquee landmarks" aria-label="Landmarks in Chhatpat">
          {[0, 1].map((k) => (
            <ul class="marquee__track" aria-hidden={k === 1 ? 'true' : undefined}>
              {LANDMARKS.map((l) => <li>{l}<span class="kite-dot" aria-hidden="true"></span></li>)}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. EVERY ROOF IS A ROUTE (1 screen) -->
  <section class="s pano" style="--h:1; --hm:1" aria-labelledby="pano-h">
    <div class="wrap">
      <div class="pano-head">
        <h2 id="pano-h">Every rooftop is a route</h2>
        <p class="lede">No lanes, no rails. Sprint from chhat to chhat, leap the gullies, climb the green pipes, slide under washing lines and air-dash over the gaps. Pick a lock and walk in through a front door.</p>
      </div>
      <div class="frame zoom pano-img">
        <Picture src={panCity} formats={['avif', 'webp']} widths={[1280, 1920]} sizes="(max-width: 900px) 1280px, 1280px" alt="Chhatpat's procedurally built Indian city from above: colourful houses, water tanks on every roof, a gurudwara with golden domes" />
      </div>
    </div>
  </section>

  <!-- 5. POWER-UPS + THE MOHALLA (2 screens) -->
  <section id="moves" class="s g2 moves" style="--h:2; --hm:2" aria-labelledby="moves-h">
    <div class="wrap">
      <div class="row">
        <div class="head2">
          <h2 id="moves-h" data-desi-text="Patang, chai aur gulel">3 power-ups: patang, chai and gulel</h2>
          <p class="lede">Plus 12 kinds of boosts lying in the street. Each hero also has a special move: Dhol Blast, Paan Pichkaari, "Khana Khaya?" and more.</p>
        </div>
        <div class="moves-grid">
          {MOVES.map((m) => (
            <article class="move">
              <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media(`clips/${m.clip}.mp4`)} poster={media(`clips/${m.clip}.jpg`)} aria-hidden="true"></video></div></div>
              <div><p class="move-name">{m.name}</p><p data-desi-text={m.desi + '. ' + m.text}>{m.text}</p></div>
            </article>
          ))}
        </div>
      </div>
      <div class="row watchers">
        <h3 data-desi-text="Mohalla dekh raha hai">Uncle Ji and the mohalla are watching</h3>
        <div class="watch-row">
          <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media('clips/v_monkeys.mp4')} poster={media('clips/v_monkeys.jpg')} aria-hidden="true"></video></div></div>
          <div class="phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media('clips/v_seth.mp4')} poster={media('clips/v_seth.jpg')} aria-hidden="true"></video></div></div>
          <div class="watch-side">
            <ul class="watch-list">{WATCHERS.map((w) => <li>{w}</li>)}</ul>
            <p class="watch-quote">Uncle Ji will remind you that Sharma ji's son got 98%.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. HEROES + OUTFITS (2 screens) -->
  <section id="heroes" class="s g2 heroes ground-paper" style="--h:2; --hm:2" aria-labelledby="heroes-h">
    <div class="wrap">
      <div class="row">
        <div class="head2">
          <h2 id="heroes-h" data-desi-text="10 heroes, 10 museebatein">10 heroes, 10 desi emergencies</h2>
          <p class="lede">Every story plays out like a filmi scene with a clock on it. Turn a card over to meet the hero.</p>
        </div>
        <ul class="hgrid">{HEROES.slice(0, 5).map((h) => <li><Card h={h} /></li>)}</ul>
      </div>
      <div class="row">
        <ul class="hgrid">{HEROES.slice(5).map((h) => <li><Card h={h} /></li>)}</ul>
        <div class="outfit-band">
          <h3>55 outfits, each with a power</h3>
          <div class="outfit-strip"><Image src={outfits} widths={[1200, 2560]} sizes="100vw" alt="Thirty Chhatpat outfits in a row: kurtas, lungis, sherwanis, a saree, a raincoat and more on blocky heroes" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FRIENDS + GHAR (2 screens) -->
  <section id="friends" class="s g2 friends" style="--h:2; --hm:2" aria-labelledby="friends-h">
    <div class="wrap">
      <div class="row">
        <h2 id="friends-h" data-desi-text="Doston ke saath, bina internet">Play with 4 friends on one Wi-Fi</h2>
        <div class="split">
          <div class="frame zoom split-img"><Picture src={friends} formats={['avif', 'webp']} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 56vw" alt="The Doston ke Saath screen in Chhatpat: host a game or join with a 5-digit game ID" /></div>
          <ol class="steps">
            <li><strong>Host a game.</strong> You get a 5-digit game ID.</li>
            <li><strong>Friends type it in.</strong> Same Wi-Fi or a phone hotspot. No internet.</li>
            <li><strong>Race the same errand.</strong> Everyone's house stands in one shared city.</li>
            <li><strong>Winner takes all.</strong> Stake up to 3 things from your home.</li>
          </ol>
        </div>
      </div>
      <div class="row">
        <div class="split rev">
          <div class="frame zoom split-img tall"><Picture src={ghar} formats={['avif', 'webp']} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 56vw" alt="Ghar Sajao in Chhatpat: a furnished house seen from above with a catalogue of home objects" /></div>
          <div class="split-copy">
            <h3 data-desi-text="Apna ghar sajao">Your own ghar in every Chhatpat city</h3>
            <p>Every run starts on your terrace. A kothi with a garden, furnished rooms and the whole joint family. Bring home what you find in the city: sofas, a jhoola, charpais, a mandir, a cooler, matkas and 284 things in all.</p>
            <p class="split-note">Today's City gives everyone the same city each day. Set your best time before a new one arrives at midnight.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. STUDIO (1 screen) -->
  <section id="studio" class="s studio-teaser ground-indigo" style="--h:1; --hm:2" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="head2">
        <h2 id="studio-h">Chhatpat is Viidesi's game one</h2>
        <p class="lede">Viidesi Studios is an independent Indian game studio. We make games about the India outside the window, right now. More games are in the works.</p>
      </div>
      <div class="cards3">
        <a class="card" href={u('studio/#brands')}>
          <span class="frame card-img"><Picture src={huddle} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" alt="A street in Chhatpat with shop signs and people chatting" /></span>
          <span class="card-k">For brands</span>
          <h3>Billboards inside Chhatpat's city</h3>
          <p>Thousands of in-world hoardings, LED screens and weekly brand hunts. No pop-ups, ever.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
        <a class="card" href={u('chhatpat/#press')}>
          <span class="frame card-img"><Picture src={cars} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" alt="Four kinds of flying cars over the rooftops of Chhatpat" /></span>
          <span class="card-k">For press and creators</span>
          <h3>The Chhatpat press kit</h3>
          <p>Fact sheet, screenshots, the icon and the trailer, ready to download.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
        <a class="card" href={u('devlog/')}>
          <span class="frame card-img"><Picture src={stepwell} formats={['avif', 'webp']} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 30vw" alt="A carved stepwell in the city of Chhatpat" /></span>
          <span class="card-k">For the curious</span>
          <h3>The Viidesi Studios devlog</h3>
          <p>How a whole Indian city gets built in seconds on a phone, and other notes.</p>
          <span class="card-go" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. FAQ (1 screen) -->
  <section id="faq" class="s faq" style="--h:1; --hm:2" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div class="faq-side"><h2 id="faq-h">Questions about Chhatpat</h2><div class="phone faq-phone"><div class="frame"><video data-auto muted loop playsinline preload="none" data-src={media('clips/sky_golden.mp4')} poster={media('clips/sky_golden.jpg')} aria-hidden="true"></video></div></div></div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details name="faq">
            <summary><h3>{f.q}</h3><span class="faq-x" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. CLOSE + FOOTER (1 screen, in the layout's footer) -->
  <Picture slot="close-bg" class="close-bg" src={panDiwali} formats={['avif', 'webp']} widths={[1280, 1920]} sizes="(max-width: 640px) 1920px, 100vw" alt="" />
  <Fragment slot="close">
    <h2 class="close-h"><span class="deva" lang="hi">चलो,</span> chhat pe milte hain</h2>
    <p class="lede">Free on Google Play. Plays offline. Five graphics modes, from 4 GB phones to flagships.</p>
    <a class="btn" href={GAME.play} rel="noopener" data-magnet><Icon name="play-store" /> <span data-desi-text="Abhi khelo, free">Get it on Google Play</span></a>
  </Fragment>

  <dialog id="trailer" class="dlg" aria-label="Chhatpat trailer">
    <button class="dlg-close" type="button" aria-label="Close the trailer">×</button>
    <video controls playsinline preload="none" data-src={media('chhatpat-trailer.mp4')} poster={media('chhatpat-trailer-poster-clean.jpg')}></video>
  </dialog>
</Base>

<style>
  /* hero */
  .hero { position: relative; height: 100svh; min-height: 560px; padding: 0 !important; display: grid; align-items: end; overflow: hidden; background: #2a2160; }
  .hero-gl { position: absolute; inset: 0; cursor: pointer; }
  .hero-gl :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .hero-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 1s; }
  .hero-gl[data-gl='on'] .hero-still { opacity: 0; }
  .hero-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(7,13,38,.55) 0%, transparent 22%, transparent 45%, rgba(7,13,38,.85) 100%), linear-gradient(90deg, rgba(7,13,38,.6), transparent 60%); }
  .hero-inner { position: relative; z-index: 2; padding-bottom: clamp(56px, 10vh, 120px); padding-top: 120px; display: grid; gap: 22px; pointer-events: none; }
  .hero-inner > * { pointer-events: auto; max-width: 760px; }
  .hero h1 { display: grid; gap: 10px; }
  .hero-word { font-size: clamp(4.2rem, 13vw, 11.5rem); line-height: 0.82; color: var(--saffron); font-variation-settings: 'wdth' 75, 'opsz' 96; letter-spacing: -0.045em; text-shadow: 0 6px 0 #c4520a, 0 20px 60px rgba(0,0,0,.45); }
  .hero-sub { font-size: clamp(1.5rem, 3vw, 2.6rem); letter-spacing: -0.02em; color: var(--cream); line-height: 1; }
  .hero .lede { color: rgba(255,244,226,.86); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-hud { position: absolute; z-index: 3; right: var(--gutter); bottom: clamp(56px, 10vh, 120px); margin: 0; padding: 10px 16px 10px 40px; border-radius: 999px; background: rgba(7,13,38,.55); backdrop-filter: blur(10px); font-weight: 700; font-size: 0.9rem; pointer-events: none; }
  .hero-hud::before { content: ''; position: absolute; left: 16px; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: var(--saffron); animation: ping 1.8s infinite; }
  .hero-hud[data-state='fall']::before { background: var(--rani); }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(255,194,61,.7); } 70%, 100% { box-shadow: 0 0 0 12px rgba(255,194,61,0); } }
  @media (max-width: 760px) {
    .hero-shade { background: linear-gradient(180deg, rgba(7,13,38,.55) 0%, transparent 20%, transparent 32%, rgba(7,13,38,.88) 52%, rgba(7,13,38,.96) 100%); }
    .hero-hud { left: var(--gutter); right: auto; top: calc(var(--nav-h) + 8px); bottom: auto; }
    .hero-cta .btn { width: 100%; }
  }
  @media (max-height: 600px) and (orientation: landscape) {
    .hero-inner { padding-top: 88px; padding-bottom: 28px; gap: 12px; }
    .hero-word { font-size: clamp(3rem, 11vh, 5rem); }
    .hero-sub { font-size: 1.3rem; }
    .hero .lede { font-size: 1rem; max-width: 52ch; }
    .hero-cta .btn { width: auto; }
    .hero-hud { top: auto; bottom: 24px; left: auto; right: var(--gutter); }
  }

  h2 { font-size: clamp(2.3rem, 4.6vw, 4.4rem); }
  main :global(h3) { font-size: clamp(1.25rem, 1.7vw, 1.6rem); }
  .head2 { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px 32px; align-items: start; }
  .head2 > :first-child { grid-column: span 6; }
  .head2 > :last-child { grid-column: 7 / -1; padding-top: 8px; }
  .head2 .lede { max-width: 52ch; }
  @media (max-width: 900px) { .head2 { grid-template-columns: 1fr; } .head2 > * { grid-column: auto !important; padding-top: 0 !important; } }

  /* trailer + numbers */
  .trailer-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 32px; align-items: start; }
  .trailer-copy { grid-column: span 5; }
  .trailer-frame { grid-column: 6 / -1; }
  .trailer-copy { display: grid; gap: 22px; }
  .trailer-frame { display: block; aspect-ratio: 16 / 10; box-shadow: 0 60px 120px -40px rgba(0,0,0,.8); }
  .trailer-play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: inline-flex; align-items: center; gap: 12px; padding: 14px 24px 14px 16px; border-radius: 999px; background: var(--saffron); color: var(--ink); font-weight: 800; white-space: nowrap; transition: transform .4s var(--ease); }
  .trailer-play :global(svg) { width: 34px; height: 34px; padding: 10px; border-radius: 50%; background: var(--ink); color: var(--saffron); }
  .trailer-frame:hover .trailer-play { transform: scale(1.06); }
  .facts-grid { margin: 8px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 16px; }
  .fact { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; }
  .fact dt { font-weight: 700; font-size: .92rem; }
  .fact dd { margin: 0; display: grid; }
  .fact strong { font: 800 clamp(1.9rem, 2.6vw, 2.6rem)/1 var(--display); color: var(--saffron); letter-spacing: -0.03em; font-variation-settings: 'wdth' 80; }
  .fact small { color: var(--muted); font-size: .8rem; line-height: 1.3; order: 2; }
  @media (max-width: 1023px) { .trailer-grid { grid-template-columns: 1fr; } .trailer-copy, .trailer-frame { grid-column: auto; } }
  @media (max-width: 560px) { .facts-grid { grid-template-columns: repeat(2, 1fr); } .trailer-play { padding: 10px 16px 10px 10px; font-size: .9rem; } }

  /* city */
  .chap-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .chap-card { display: grid; grid-template-columns: 200px 1fr; gap: 28px; align-items: center; }
  .chap-card .phone { width: 200px; }
  .chap-text { display: grid; gap: 12px; }
  
  .chap-text p:not(.eyebrow) { color: var(--muted); }
  .landmarks ul { list-style: none; margin: 0; }
  .landmarks li { display: inline-flex; align-items: center; gap: 48px; font: 800 clamp(2.2rem, 4.6vw, 4rem)/1.1 var(--display); letter-spacing: -0.03em; white-space: nowrap; font-variation-settings: 'wdth' 80; }
  .landmarks li:nth-child(odd) { color: var(--saffron); }
