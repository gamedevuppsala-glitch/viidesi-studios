---
import { Image } from 'astro:assets';
import { HEROES } from '../data/game';
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/heroes/*.png', { eager: true });
const art = (id: string) => portraits[`../assets/heroes/${id}.png`]?.default;
interface Props { id?: string }
const { id = 'heroes' } = Astro.props;
---
<section id={id} class="heroes ground-paper" aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">Parivaar</p>
      <h2 id={`${id}-h`} data-reveal data-desi-text="10 heroes, 10 museebatein">10 heroes, 10 desi emergencies</h2>
      <p class="lede">Every story plays out like a filmi scene with a clock on it. Turn a card over to meet the hero.</p>
    </div>
    <ul class="hgrid">
      {HEROES.map((h) => {
        const a = art(h.id);
        return (
          <li>
            <button class="hcard" type="button" aria-pressed="false" style={`--c:${h.colour}`}>
              <span class="hface front">
                <span class="hart">
                  {a ? <Image src={a} alt={`${h.name}, a Chhatpat hero`} width={340} height={272} /> : <span class="hlock" aria-hidden="true">?</span>}
                </span>
                <span class="hname">{h.name}</span>
                <span class="hstory">{h.story}</span>
                <span class="hlog">{h.logline}</span>
              </span>
              <span class="hface back">
                <span class="hyeh">{h.intro[0]}</span>
                <span class="hline">{h.intro[1]}</span>
              </span>
            </button>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .hgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .hcard { position: relative; width: 100%; aspect-ratio: 3 / 4.4; padding: 0; border: 0; background: none; cursor: pointer; perspective: 1200px; text-align: left; color: var(--ink); }
  .hface { position: absolute; inset: 0; border-radius: var(--r-m); backface-visibility: hidden; transition: transform .8s var(--ease), box-shadow .4s; display: flex; flex-direction: column; overflow: hidden; }
  .front { background: #fff8ec; box-shadow: 0 1px 0 rgba(0,0,0,.04), 0 18px 40px -24px rgba(10,18,51,.45); }
  .hcard:hover .front { transform: translateY(-2px); box-shadow: 0 30px 50px -24px rgba(10,18,51,.5); }
  .hart { position: relative; aspect-ratio: 340 / 272; background: repeating-conic-gradient(from 0deg at 50% 70%, var(--c) 0 10deg, color-mix(in srgb, var(--c) 72%, #000) 10deg 20deg); overflow: hidden; }
  .hart :global(img) { width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; transition: transform .8s var(--ease); }
  .hcard:hover .hart :global(img) { transform: scale(1.03); }
  .hlock { position: absolute; inset: 0; display: grid; place-items: center; font: 800 4rem/1 var(--display); color: rgba(255,255,255,.85); background: rgba(10,18,51,.35); }
  .hname { font: 800 1.35rem/1 var(--display); padding: 16px 16px 4px; letter-spacing: -0.02em; }
  .hstory { padding: 0 16px; font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: color-mix(in srgb, var(--c) 70%, #000); }
  .hlog { padding: 10px 16px 16px; font-size: .92rem; line-height: 1.4; color: rgba(10,18,51,.72); }
  .back { transform: rotateY(180deg); background: var(--c); color: #fff; padding: 22px; justify-content: flex-end; gap: 10px; background-image: radial-gradient(120% 80% at 50% 0%, rgba(255,255,255,.25), transparent 60%); }
  .hyeh { font: 800 1.6rem/1 var(--display); letter-spacing: -0.02em; text-shadow: 0 2px 0 rgba(0,0,0,.2); }
  .hline { font-weight: 700; font-size: 1rem; line-height: 1.35; text-transform: uppercase; letter-spacing: .02em; }
  .hcard[aria-pressed='true'] .front { transform: rotateY(-180deg); }
  .hcard[aria-pressed='true'] .back { transform: rotateY(0); }
  @media (max-width: 1100px) { .hgrid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 820px) { .hgrid { grid-template-columns: repeat(2, 1fr); } .hlog { display: none; } }
</style>
