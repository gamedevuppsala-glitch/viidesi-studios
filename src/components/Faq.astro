---
interface Props { items: { q: string; a: string }[]; id?: string; title?: string }
const { items, id = 'faq', title = 'Questions about Chhatpat' } = Astro.props;
---
<section id={id} class="faq" aria-labelledby={`${id}-h`}>
  <div class="wrap faq-grid">
    <div class="sec-head">
      <p class="eyebrow">FAQ</p>
      <h2 id={`${id}-h`} data-reveal>{title}</h2>
    </div>
    <div class="faq-list">
      {items.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary><h3>{f.q}</h3><span class="faq-x" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-grid .sec-head { position: sticky; top: 110px; }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; min-height: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: clamp(1.15rem, 1.6vw, 1.45rem); font-family: var(--body); font-weight: 700; letter-spacing: -0.01em; transition: color .2s; }
  summary:hover h3 { color: var(--saffron); }
  details p { padding: 0 48px 26px 0; color: var(--muted); }
  .faq-x { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,244,226,.08); transition: transform .4s var(--ease), background .3s; }
  .faq-x::before, .faq-x::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; margin: -1px 0 0 -7px; background: currentColor; border-radius: 2px; }
  .faq-x::after { transform: rotate(90deg); transition: transform .4s var(--ease); }
  details[open] .faq-x { background: var(--saffron); color: var(--ink); }
  details[open] .faq-x::after { transform: rotate(0); }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } .faq-grid .sec-head { position: static; } }
</style>
